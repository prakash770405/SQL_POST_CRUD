<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SQL Data</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: Arial, sans-serif;
        }

        body {
            background: #f4f4f4;
            padding: 30px;
        }

        .container {
            max-width: 1200px;
            margin: auto;
        }

        .title {
            text-align: center;
            margin-bottom: 10px;
            color: #333;
        }

        .count {
            text-align: center;
            margin-bottom: 30px;
            color: #666;
        }

        .card-container {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 20px;
        }

        .card {
            background: white;
            padding: 20px;
            border-radius: 12px;
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
            transition: 0.3s;
        }

        .card:hover {
            transform: translateY(-5px);
        }

        .profile-img {
            width: 100px;
            height: 100px;
            border-radius: 50%;
            object-fit: cover;
            display: block;
            margin: 0 auto 15px;
            border: 3px solid #3498db;
        }

        .info {
            margin: 10px 0;
            color: #444;
        }

        .label {
            font-weight: bold;
            color: #222;
        }

        .email {
            color: #3498db;
            word-break: break-word;
        }

        .id {
            font-size: 12px;
            color: gray;
            word-break: break-all;
        }
    </style>
</head>

<body>

    <div class="container">

        <h1 class="title">SQL Data</h1>
        <h2 class="count">Total Users: <%= results.length %> </h2>
        <h2 class="count"><a href="http://locahost:8080/insert/data">Insert New Data</a></h2>

        <div class="card-container">

            <% for(let i=0; i < results.length; i++) { %>

                <div class="card">

                    <img src="<%= results[i].images %>" alt="photo" class="profile-img">

                    <p class="info id">
                        <span class="label">ID:</span>
                        <%= results[i].Id %>
                    </p>

                    <p class="info">
                        <span class="label">Name:</span>
                        <%= results[i].Name %>
                    </p>

                    <p class="info email">
                        <span class="label">Email:</span>
                        <%= results[i].Email %>
                    </p>

                    <a href="http://localhost:8080/post/edit/<%=results[i].Id%>">Edit</a>
                    <form style="display: inline-block; margin-left: 10px;"
                        action="http://localhost:8080/post/delete/<%=results[i].Id%>?_method=DELETE" method="post">
                        <button type="submit">Delete</button>
                    </form>

                </div>

                <% } %>

        </div>

    </div>

</body>

</html>